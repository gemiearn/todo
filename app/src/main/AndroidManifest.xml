<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        提醒要的三样权限，都不涉及网络与账号：

        - POST_NOTIFICATIONS：Android 13 起发通知要运行时授权。没授权时 App 照常能用，
          只是提醒不会弹——设置页会显示「未开启」，不会假装已经设好了。
        - SCHEDULE_EXACT_ALARM：Android 12 起的精确闹钟。默认走非精确调度，只有用户在
          设置页打开「准点提醒」时才会用到它；用户随时可以在系统设置里收回。
        - RECEIVE_BOOT_COMPLETED：重启后把闹钟重新排上，否则重启一次就再也不响。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        lint 的 ProtectedPermissions 把这一条判成「只授予系统应用」，是误报：SCHEDULE_EXACT_ALARM
        在 Android 12 起是普通权限，用户可以在系统设置里授予，也可以随时收回（我们正是靠
        canScheduleExactAlarms() 检测它）。所以这里显式忽略那一条，而不是改用 Play 上受限的
        USE_EXACT_ALARM。
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Phase 1 keeps every task on the device: no network, no accounts - and no
        Android auto backup either, so the local database is never uploaded to
        Google's servers. allowBackup plus fullBackupContent cover Android 11 and
        lower, dataExtractionRules covers Android 12 and higher. A user controlled
        export is planned as a later phase.

        上面那三样权限只服务于本地提醒，没有一个会把数据发出去。
    -->
    <application
        android:name=".TodoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TodoPomodoro">

        <!--
            入口是 MainActivity，但**桌面图标不属于它**：图标在设置页可切换，做法是给它
            挂 6 个 activity-alias，每个 alias 带自己的一套 android:icon，同一时刻只有
            一个 enabled。MainActivity 因此不再挂 MAIN/LAUNCHER，否则桌面上会出现两个
            入口。

            切换由 PackageManager.setComponentEnabledSetting 完成（见
            data/AppearanceSettings.kt 里的 LauncherIcon 与 applyLauncherIcon）。系统桌面
            会在切完之后重建这一个入口。

            alias 上不写 android:label：它会继承 targetActivity 的，也就是 @string/app_name，
            写了反而多一条 RedundantLabel 警告。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TodoPomodoro" />

        <!--
            提醒的三个广播接收器：

            - ReminderReceiver：闹钟到点，发通知。显式 Intent 唤起，不需要 exported。
            - ReminderActionReceiver：通知上的「完成」「稍后 10 分钟」两个按钮。
            - ReminderBootReceiver：开机、App 更新、改时区、改系统时间之后重排闹钟。
              这几件事都会让系统清掉或算错已经设好的闹钟，不重排的话界面上还写着
              「提醒 20:00」，到点却一声不响。
        -->
        <receiver
            android:name=".notification.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notification.ReminderActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".notification.ReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 默认那版：B·计时环（也就是安装后桌面上看到的第一个图标）。 -->
        <activity-alias
            android:name=".MainActivityRing"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- A·番茄 -->
        <activity-alias
            android:name=".MainActivityTomato"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_tomato"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- D·时钟面 -->
        <activity-alias
            android:name=".MainActivityClock"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_clock"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- E·四色方块 -->
        <activity-alias
            android:name=".MainActivityQuad"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_quad"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- F·青柠渐变 -->
        <activity-alias
            android:name=".MainActivityLime"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_lime"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- G·暖阳渐变 -->
        <activity-alias
            android:name=".MainActivitySun"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sun"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>

