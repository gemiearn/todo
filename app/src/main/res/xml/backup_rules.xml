<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 (API 30) and lower honour this file for auto backup. Phase 1
    keeps the local database on the device, so every domain is excluded here
    as well. Android 12 and higher use data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
