<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device. From Android 12 (API 31) the platform honours
    this file instead of android:allowBackup, so both cloud backup and
    device-to-device transfer have to be excluded explicitly. The manifest
    attribute still covers Android 11 and lower.

    A user controlled export is planned as a later phase and will be the only
    way data moves off the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
